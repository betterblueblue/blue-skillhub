+    /**
+     * 复制参数配置
+     */
+    @RequiresPermissions("system:config:add")
+    @Log(title = "参数管理", businessType = BusinessType.INSERT)
+    @PostMapping("/copy")
+    @ResponseBody
+    public AjaxResult copy(Long configId)
+    {
+        SysConfig origin = configService.selectConfigById(configId);
+        if (StringUtils.isNull(origin))
+        {
+            return error("复制参数失败，参数不存在");
+        }
+        SysConfig config = new SysConfig();
+        config.setConfigName("副本" + origin.getConfigName());
+        config.setConfigKey(origin.getConfigKey() + "_copy");
+        config.setConfigValue(origin.getConfigValue());
+        config.setConfigType("N");
+        config.setRemark(origin.getRemark());
+        if (!configService.checkConfigKeyUnique(config))
+        {
+            return error("复制参数'" + origin.getConfigName() + "'失败，参数键名已存在");
+        }
+        config.setCreateBy(getLoginName());
+        return toAjax(configService.insertConfig(config));
+    }
